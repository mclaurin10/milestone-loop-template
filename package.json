{
  "name": "milestone-loop-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous milestone loop template: planner/worker/reviewer orchestration with receipt-owning, tiered, fail-closed verification",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.15.1",
  "milestoneLoop": {
    "verification": {
      "defaultProfile": "readiness"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:dependencies": "node tools/placeholder-check.mjs verify:dependencies",
    "format": "prettier --write scripts tools eslint.config.mjs package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.tools.json vitest.config.ts",
    "format:check": "tsx tools/run-tool-evidence.mjs format",
    "lint": "tsx tools/run-tool-evidence.mjs lint",
    "lint:architecture": "node tools/placeholder-check.mjs lint:architecture",
    "typecheck": "tsx tools/run-tool-evidence.mjs typecheck",
    "build": "tsx tools/run-tool-evidence.mjs build",
    "test:unit": "tsx tools/run-tool-evidence.mjs test",
    "test:invariants": "tsx tools/milestone-orchestrator/src/verification-cli.ts invariants",
    "test:unit:fast": "tsx tools/milestone-orchestrator/src/verification-cli.ts fast-unit",
    "test:unit:migrations": "tsx tools/milestone-orchestrator/src/verification-cli.ts migration-unit",
    "test:orchestrator": "tsx tools/run-tool-evidence.mjs orchestrator",
    "verify:domain-construction-standard": "node tools/placeholder-check.mjs verify:domain-construction-standard",
    "verify:domain-resources": "node tools/placeholder-check.mjs verify:domain-resources",
    "verify:domain-networks": "node tools/placeholder-check.mjs verify:domain-networks",
    "verify:domain-planning": "node tools/placeholder-check.mjs verify:domain-planning",
    "verify:domain-entitlement": "node tools/placeholder-check.mjs verify:domain-entitlement",
    "verify:domain-entitlement-standard": "node tools/placeholder-check.mjs verify:domain-entitlement-standard",
    "verify:domain-development": "node tools/placeholder-check.mjs verify:domain-development",
    "verify:domain-simulation": "node tools/placeholder-check.mjs verify:domain-simulation",
    "verify:domain-browser": "node tools/placeholder-check.mjs verify:domain-browser",
    "verify:iteration": "tsx tools/milestone-orchestrator/src/verification-cli.ts iteration",
    "verify:candidate": "tsx tools/milestone-orchestrator/src/verification-cli.ts candidate",
    "verify:milestone": "tsx tools/milestone-orchestrator/src/verification-cli.ts milestone",
    "verify:periodic": "tsx tools/milestone-orchestrator/src/verification-cli.ts periodic",
    "loop:status": "tsx tools/milestone-orchestrator/src/cli.ts status",
    "loop:doctor": "tsx tools/milestone-orchestrator/src/cli.ts doctor",
    "loop:check-model-policy": "tsx tools/milestone-orchestrator/src/cli.ts check-model-policy",
    "loop:telemetry:report": "tsx tools/milestone-orchestrator/src/telemetry-report.ts",
    "loop:benchmark": "tsx tools/milestone-orchestrator/src/benchmark.ts",
    "artifacts:inventory": "tsx tools/milestone-orchestrator/src/artifact-inventory.ts",
    "artifacts:retention:dry-run": "tsx tools/milestone-orchestrator/src/retention-plan.ts",
    "loop:plan": "tsx tools/milestone-orchestrator/src/cli.ts plan",
    "loop:run": "tsx tools/milestone-orchestrator/src/cli.ts run",
    "loop:resume": "tsx tools/milestone-orchestrator/src/cli.ts resume",
    "loop:reconcile": "tsx tools/milestone-orchestrator/src/cli.ts reconcile",
    "loop:reconcile-status": "tsx tools/milestone-orchestrator/src/cli.ts reconcile-status",
    "loop:dry-run": "tsx tools/milestone-orchestrator/src/cli.ts dry-run",
    "loop:canary": "tsx tools/milestone-orchestrator/src/cli.ts canary",
    "loop:demo-safety": "tsx tools/milestone-orchestrator/src/cli.ts demo-safety"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@milestone-loop/orchestrator": "workspace:0.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
