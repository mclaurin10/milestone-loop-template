{
  "name": "ski-tycoon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ski Tycoon deterministic technical bootstrap",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.15.1",
  "skiTycoon": {
    "verification": {
      "defaultProfile": "readiness"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:dependencies": "node tools/verify-dependencies.mjs",
    "format": "prettier --write apps packages tests tools eslint.config.mjs package.json playwright.config.ts pnpm-workspace.yaml tsconfig.base.json tsconfig.tools.json vitest.config.ts",
    "format:check": "tsx tools/run-tool-evidence.mjs format",
    "lint": "tsx tools/run-tool-evidence.mjs lint",
    "lint:architecture": "node tools/verify-architecture.mjs",
    "typecheck": "tsx tools/run-tool-evidence.mjs typecheck",
    "build": "tsx tools/run-tool-evidence.mjs build",
    "test:unit": "tsx tools/run-tool-evidence.mjs test",
    "test:invariants": "tsx tools/milestone-orchestrator/src/verification-cli.ts invariants",
    "test:unit:fast": "tsx tools/milestone-orchestrator/src/verification-cli.ts fast-unit",
    "test:unit:migrations": "tsx tools/milestone-orchestrator/src/verification-cli.ts migration-unit",
    "verify:bootstrap:simulation": "tsx tools/verify-calendar.mjs bootstrap-smoke-simulation",
    "verify:bootstrap:persistence": "tsx tools/verify-bootstrap-persistence.ts",
    "verify:bootstrap:browser": "node tools/verify-bootstrap-browser.mjs",
    "verify:calendar-simulation": "tsx tools/verify-calendar.mjs simulation",
    "verify:calendar-browser": "tsx tools/verify-calendar.mjs browser",
    "verify:valley-simulation": "tsx tools/verify-valley.mjs simulation",
    "verify:valley-browser": "tsx tools/verify-valley.mjs browser",
    "verify:terrain-simulation": "tsx tools/verify-valley.mjs terrain-simulation",
    "verify:terrain-browser": "tsx tools/verify-valley.mjs terrain-browser",
    "verify:finance-simulation": "tsx tools/verify-finance.mjs simulation",
    "verify:finance-browser": "tsx tools/verify-finance.mjs browser",
    "verify:development-simulation": "tsx tools/verify-development.mjs simulation",
    "verify:development-browser": "tsx tools/verify-development.mjs browser",
    "verify:authorization-simulation": "tsx tools/verify-authorization.mjs simulation",
    "verify:authorization-browser": "tsx tools/verify-authorization.mjs browser",
    "verify:construction-resources": "node tools/verify-construction-resources.mjs",
    "verify:utility-networks": "node tools/verify-utility-networks.mjs",
    "verify:utility-planning": "tsx tools/verify-utility-planning.mjs",
    "verify:utility-entitlement": "tsx tools/verify-utility-entitlement.mjs",
    "verify:standard-utility-entitlement": "tsx tools/verify-standard-utility-entitlement.mjs",
    "verify:standard-utility-construction": "node tools/verify-standard-utility-construction.mjs",
    "test:orchestrator": "tsx tools/run-tool-evidence.mjs orchestrator",
    "verify:iteration": "tsx tools/milestone-orchestrator/src/verification-cli.ts iteration",
    "verify:candidate": "tsx tools/milestone-orchestrator/src/verification-cli.ts candidate",
    "verify:milestone": "tsx tools/milestone-orchestrator/src/verification-cli.ts milestone",
    "verify:periodic": "tsx tools/milestone-orchestrator/src/verification-cli.ts periodic",
    "loop:status": "tsx tools/milestone-orchestrator/src/cli.ts status",
    "loop:doctor": "tsx tools/milestone-orchestrator/src/cli.ts doctor",
    "loop:check-model-policy": "tsx tools/milestone-orchestrator/src/cli.ts check-model-policy",
    "loop:telemetry:report": "tsx tools/milestone-orchestrator/src/telemetry-report.ts",
    "loop:benchmark": "tsx tools/milestone-orchestrator/src/benchmark.ts",
    "artifacts:inventory": "tsx tools/milestone-orchestrator/src/artifact-inventory.ts",
    "artifacts:retention:dry-run": "tsx tools/milestone-orchestrator/src/retention-plan.ts",
    "loop:plan": "tsx tools/milestone-orchestrator/src/cli.ts plan",
    "loop:run": "tsx tools/milestone-orchestrator/src/cli.ts run",
    "loop:resume": "tsx tools/milestone-orchestrator/src/cli.ts resume",
    "loop:reconcile": "tsx tools/milestone-orchestrator/src/cli.ts reconcile",
    "loop:reconcile-status": "tsx tools/milestone-orchestrator/src/cli.ts reconcile-status",
    "loop:dry-run": "tsx tools/milestone-orchestrator/src/cli.ts dry-run",
    "loop:canary": "tsx tools/milestone-orchestrator/src/cli.ts canary",
    "loop:demo-safety": "tsx tools/milestone-orchestrator/src/cli.ts demo-safety",
    "dev": "vite --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "headless:smoke": "tsx apps/headless/src/main.ts"
  },
  "devDependencies": {
    "@babylonjs/core": "9.19.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@ski-tycoon/headless": "workspace:0.0.0",
    "@ski-tycoon/orchestrator": "workspace:0.0.0",
    "@ski-tycoon/persistence": "workspace:0.0.0",
    "@ski-tycoon/protocol": "workspace:0.0.0",
    "@ski-tycoon/simulation": "workspace:0.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
