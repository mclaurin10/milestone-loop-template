            "baseCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "clean": { "const": true },
            "changedEntriesDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "verificationResultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executionProvider": {
          "oneOf": [{ "$ref": "#/$defs/executionProvider" }, { "type": "null" }]
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        },
        "outcomePath": { "type": "string", "minLength": 1 },
        "outcomeTemporaryPath": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": [
            "intent-persisted",
            "outcome-pending",
            "target-update-started",
            "target-updated",
            "outcome-integrated",
            "blocked"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completionAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-adopt-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "targetHead",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "candidate-drift",
                    "outcome-conflict",
                    "state-target-inconsistent",
                    "target-branch-mismatch",
                    "target-dirty",
                    "target-index-locked",
                    "target-operation-in-progress",
                    "target-path-unsafe",
                    "target-unexpected-commit",
                    "workspace-path-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "targetHead": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[a-f0-9]{40}$" }
                  ]
                },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
