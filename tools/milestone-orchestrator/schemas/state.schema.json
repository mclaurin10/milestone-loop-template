{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestone-loop.local/schemas/orchestrator-state-1.5.0.json",
  "title": "Example Project Orchestrator State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "repository",
    "queue",
    "milestones",
    "activeMilestoneId",
    "requiredNextVerticalConsumer",
    "run",
    "hiddenValidation",
    "evidenceRetention",
    "controllerHistory",
    "reconciliation",
    "pendingOperation",
    "nextAllowedAction",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.5.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "repository": { "type": "object" },
    "queue": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "milestones": { "type": "array", "items": { "type": "object" } },
    "activeMilestoneId": { "type": ["string", "null"] },
    "requiredNextVerticalConsumer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceMilestoneId",
            "consumerMilestoneId",
            "consumerContractSha256"
          ],
          "properties": {
            "sourceMilestoneId": { "type": "string", "minLength": 1 },
            "consumerMilestoneId": { "type": "string", "minLength": 1 },
            "consumerContractSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "run": { "type": "object" },
    "hiddenValidation": { "type": "object" },
    "evidenceRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "initializedAt",
        "legacyRunIds",
        "lastPrunedAt",
        "lastReportPath"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "initializedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "legacyRunIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "lastPrunedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "lastReportPath": { "type": ["string", "null"] }
      }
    },
    "controllerHistory": {
      "type": "array",
      "items": { "$ref": "#/$defs/controllerArchive" }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "history"],
      "properties": {
        "active": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "https://milestone-loop.local/schemas/orchestrator-reconciliation-1.0.0.json"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "https://milestone-loop.local/schemas/orchestrator-reconciliation-1.0.0.json"
          }
        }
      }
    },
    "pendingOperation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/workspaceCreateOperation" }
      ]
    },
    "nextAllowedAction": {
      "enum": [
        "plan",
        "start-milestone",
        "resume-worker",
        "verify",
        "review",
        "integrate",
        "retry",
        "reconcile",
        "stop"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "workspaceCreateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "runId",
        "milestoneId",
        "attempt",
        "inputStateGeneration",
        "inputStateRevision",
        "repositoryRoot",
        "workspaceRoot",
        "targetBranch",
        "baseCommit",
        "branch",
        "temporaryPath",
        "finalPath",
        "phase",
        "createdAt",
        "updatedAt",
        "recoveryPolicy",
        "diagnostic"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "workspace-create" },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "runId": { "type": "string", "minLength": 1 },
        "milestoneId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "inputStateGeneration": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputStateRevision": { "type": "integer", "minimum": 0 },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "temporaryPath": { "type": "string", "minLength": 1 },
        "finalPath": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": [
            "intent-persisted",
            "clone-started",
            "clone-ready",
            "publish-started",
            "published",
            "blocked"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-adopt-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "ambiguous-paths",
                    "invalid-final-workspace",
                    "invalid-temporary-workspace",
                    "publication-conflict",
                    "workspace-root-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\r\\n\\u0000]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "controllerArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "rawSourceState",
        "sourceStateSchemaVersion",
        "sourceRevision",
        "priorVerifiedCommit",
        "priorRun",
        "priorQueue",
        "priorActiveMilestoneId",
        "priorNextAllowedAction",
        "archivedAt",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "rawSourceState": { "$ref": "#/$defs/artifactReference" },
        "sourceStateSchemaVersion": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "integer", "minimum": 0 },
        "priorVerifiedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "priorRun": { "type": "object" },
        "priorQueue": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "priorActiveMilestoneId": { "type": ["string", "null"] },
        "priorNextAllowedAction": { "type": "string", "minLength": 1 },
        "archivedAt": { "type": "string", "format": "date-time" },
        "reason": { "const": "external-integration-reconciliation" }
      }
    }
  }
}
