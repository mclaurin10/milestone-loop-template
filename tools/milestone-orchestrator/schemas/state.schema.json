          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workspacePath": { "type": "string", "minLength": 1 },
        "workspaceBranch": { "type": "string", "minLength": 1 },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCommit",
            "commit",
            "tree",
            "clean",
