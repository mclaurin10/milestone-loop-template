{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestone-loop.local/schemas/orchestrator-state-1.8.0.json",
  "title": "Example Project Orchestrator State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "repository",
    "queue",
    "milestones",
    "activeMilestoneId",
    "requiredNextVerticalConsumer",
    "run",
    "hiddenValidation",
    "evidenceRetention",
    "controllerHistory",
    "reconciliation",
    "pendingOperation",
    "nextAllowedAction",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.8.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "repository": { "type": "object" },
    "queue": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "milestones": { "type": "array", "items": { "type": "object" } },
    "activeMilestoneId": { "type": ["string", "null"] },
    "requiredNextVerticalConsumer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceMilestoneId",
            "consumerMilestoneId",
            "consumerContractSha256"
          ],
          "properties": {
            "sourceMilestoneId": { "type": "string", "minLength": 1 },
            "consumerMilestoneId": { "type": "string", "minLength": 1 },
            "consumerContractSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "run": { "type": "object" },
    "hiddenValidation": { "type": "object" },
    "evidenceRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "initializedAt",
        "legacyRunIds",
        "lastPrunedAt",
        "lastReportPath"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "initializedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "legacyRunIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "lastPrunedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "lastReportPath": { "type": ["string", "null"] }
      }
    },
    "controllerHistory": {
      "type": "array",
      "items": { "$ref": "#/$defs/controllerArchive" }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "history"],
      "properties": {
        "active": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "https://milestone-loop.local/schemas/orchestrator-reconciliation-1.0.0.json"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "https://milestone-loop.local/schemas/orchestrator-reconciliation-1.0.0.json"
          }
        }
      }
    },
    "pendingOperation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/workspaceCreateOperation" },
        { "$ref": "#/$defs/targetIntegrateOperation" },
        { "$ref": "#/$defs/workspaceCleanupOperation" },
        { "$ref": "#/$defs/retentionApplyOperation" }
      ]
    },
    "nextAllowedAction": {
      "enum": [
        "plan",
        "start-milestone",
        "resume-worker",
        "verify",
        "review",
        "integrate",
        "retry",
        "reconcile",
        "stop"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "workspaceCreateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "runId",
        "milestoneId",
        "attempt",
        "inputStateGeneration",
        "inputStateRevision",
        "repositoryRoot",
        "workspaceRoot",
        "targetBranch",
        "baseCommit",
        "branch",
        "temporaryPath",
        "finalPath",
        "phase",
        "createdAt",
        "updatedAt",
        "recoveryPolicy",
        "diagnostic"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "workspace-create" },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "runId": { "type": "string", "minLength": 1 },
        "milestoneId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "inputStateGeneration": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputStateRevision": { "type": "integer", "minimum": 0 },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "temporaryPath": { "type": "string", "minLength": 1 },
        "finalPath": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": [
            "intent-persisted",
            "clone-started",
            "clone-ready",
            "publish-started",
            "published",
            "blocked"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-adopt-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "ambiguous-paths",
                    "invalid-final-workspace",
                    "invalid-temporary-workspace",
                    "publication-conflict",
                    "workspace-root-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "targetIntegrateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "runId",
        "milestoneId",
        "attempt",
        "inputStateGeneration",
        "inputStateRevision",
        "repositoryRoot",
        "targetBranch",
        "expectedBaseCommit",
        "workspacePath",
        "workspaceBranch",
        "candidate",
        "verificationResultSha256",
        "commits",
        "outcomePath",
        "outcomeTemporaryPath",
        "phase",
        "createdAt",
        "updatedAt",
        "completionAt",
        "recoveryPolicy",
        "diagnostic"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "target-integrate" },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "runId": { "type": "string", "minLength": 1 },
        "milestoneId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "inputStateGeneration": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputStateRevision": { "type": "integer", "minimum": 0 },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "expectedBaseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workspacePath": { "type": "string", "minLength": 1 },
        "workspaceBranch": { "type": "string", "minLength": 1 },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCommit",
            "commit",
            "tree",
            "clean",
            "changedEntriesDigest"
          ],
          "properties": {
            "baseCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "clean": { "const": true },
            "changedEntriesDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "verificationResultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        },
        "outcomePath": { "type": "string", "minLength": 1 },
        "outcomeTemporaryPath": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": [
            "intent-persisted",
            "outcome-pending",
            "target-update-started",
            "target-updated",
            "outcome-integrated",
            "blocked"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completionAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-adopt-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "targetHead",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "candidate-drift",
                    "outcome-conflict",
                    "state-target-inconsistent",
                    "target-branch-mismatch",
                    "target-dirty",
                    "target-index-locked",
                    "target-operation-in-progress",
                    "target-path-unsafe",
                    "target-unexpected-commit",
                    "workspace-path-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "targetHead": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[a-f0-9]{40}$" }
                  ]
                },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "workspaceCleanupOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "runId",
        "milestoneId",
        "attempt",
        "inputStateGeneration",
        "inputStateRevision",
        "repositoryRoot",
        "workspaceRoot",
        "artifactRoot",
        "targetBranch",
        "verifiedCommit",
        "workspacePath",
        "workspaceBranch",
        "workspaceBaseCommit",
        "recordedHeadCommit",
        "observedHeadCommit",
        "workspaceCreatedAt",
        "workspaceCreateOperationId",
        "workspaceStatusSha256",
        "reason",
        "runArtifactDirectory",
        "diagnosticArchivePath",
        "diagnosticFiles",
        "phase",
        "createdAt",
        "updatedAt",
        "requestedAt",
        "completionAt",
        "recoveryPolicy",
        "diagnostic"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "workspace-cleanup" },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "runId": { "type": "string", "minLength": 1 },
        "milestoneId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "inputStateGeneration": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputStateRevision": { "type": "integer", "minimum": 0 },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "artifactRoot": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "verifiedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workspacePath": { "type": "string", "minLength": 1 },
        "workspaceBranch": { "type": "string", "minLength": 1 },
        "workspaceBaseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "recordedHeadCommit": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          ]
        },
        "observedHeadCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workspaceCreatedAt": { "type": "string", "format": "date-time" },
        "workspaceCreateOperationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workspaceStatusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "enum": [
            "completed-delete-workspace",
            "completed-preserve-workspace",
            "failed-delete-after-diagnostics",
            "failed-preserve-workspace"
          ]
        },
        "runArtifactDirectory": { "type": ["string", "null"] },
        "diagnosticArchivePath": { "type": ["string", "null"] },
        "diagnosticFiles": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "bytes"],
            "properties": {
              "name": {
                "enum": [
                  "git-status.txt",
                  "workspace.diff",
                  "recent-git-log.txt"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "phase": {
          "enum": [
            "intent-persisted",
            "dependency-removal-started",
            "dependencies-removed",
            "archive-started",
            "archive-ready",
            "workspace-delete-started",
            "workspace-deleted",
            "blocked"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "completionAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-adopt-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "archive-conflict",
                    "archive-root-unsafe",
                    "diagnostic-source-drift",
                    "premature-workspace-missing",
                    "state-workspace-inconsistent",
                    "workspace-identity-drift",
                    "workspace-root-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "retentionApplyOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "inputStateGeneration",
        "inputStateRevision",
        "repositoryRoot",
        "targetBranch",
        "verifiedCommit",
        "runStatus",
        "runId",
        "retentionInitializedAt",
        "previousLastPrunedAt",
        "previousLastReportPath",
        "planPath",
        "planSha256",
        "planBytes",
        "planGeneratedAt",
        "candidate",
        "keepRecentRuns",
        "verificationArtifactRoot",
        "verificationArtifactRootRealpath",
        "verificationObservedRunIds",
        "controllerArtifactRoot",
        "controllerArtifactRootRealpath",
        "controllerObservedRunIds",
        "applyDirectory",
        "journalPath",
        "resultPath",
        "deletions",
        "phase",
        "completedDeletionCount",
        "createdAt",
        "updatedAt",
        "completionAt",
        "recoveryPolicy",
        "diagnostic"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "retention-apply" },
        "id": {
          "type": "string",
          "pattern": "^retention-apply-[a-f0-9]{64}$"
        },
        "inputStateGeneration": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputStateRevision": { "type": "integer", "minimum": 0 },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "verifiedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runStatus": { "enum": ["idle", "stopped"] },
        "runId": { "type": ["string", "null"] },
        "retentionInitializedAt": {
          "type": "string",
          "format": "date-time"
        },
        "previousLastPrunedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "previousLastReportPath": { "type": ["string", "null"] },
        "planPath": { "type": "string", "minLength": 1 },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planBytes": { "type": "integer", "minimum": 1 },
        "planGeneratedAt": { "type": "string", "format": "date-time" },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree", "dirty", "worktreeSha256"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "dirty": { "type": "boolean" },
            "worktreeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "keepRecentRuns": { "type": "integer", "minimum": 0 },
        "verificationArtifactRoot": { "type": "string", "minLength": 1 },
        "verificationArtifactRootRealpath": {
          "type": "string",
          "minLength": 1
        },
        "verificationObservedRunIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "controllerArtifactRoot": { "type": "string", "minLength": 1 },
        "controllerArtifactRootRealpath": {
          "type": "string",
          "minLength": 1
        },
        "controllerObservedRunIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "applyDirectory": { "type": "string", "minLength": 1 },
        "journalPath": { "type": "string", "minLength": 1 },
        "resultPath": { "type": "string", "minLength": 1 },
        "deletions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "root", "runId", "path", "finishedAt"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0 },
              "root": { "enum": ["verification", "controller"] },
              "runId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "path": { "type": "string", "minLength": 1 },
              "finishedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "phase": {
          "enum": [
            "intent-persisted",
            "deletion-started",
            "deletion-finished",
            "result-written",
            "blocked"
          ]
        },
        "completedDeletionCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completionAt": { "type": "string", "format": "date-time" },
        "recoveryPolicy": { "const": "validate-resume-or-preserve" },
        "diagnostic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification",
                "message",
                "observedAt",
                "preservedPaths",
                "quarantinePath"
              ],
              "properties": {
                "classification": {
                  "enum": [
                    "candidate-drift",
                    "config-drift",
                    "eligibility-drift",
                    "journal-conflict",
                    "premature-run-missing",
                    "result-conflict",
                    "retention-root-unsafe",
                    "run-path-unsafe"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "observedAt": { "type": "string", "format": "date-time" },
                "preservedPaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "quarantinePath": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\r\\n\\u0000]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "controllerArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "rawSourceState",
        "sourceStateSchemaVersion",
        "sourceRevision",
        "priorVerifiedCommit",
        "priorRun",
        "priorQueue",
        "priorActiveMilestoneId",
        "priorNextAllowedAction",
        "archivedAt",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "rawSourceState": { "$ref": "#/$defs/artifactReference" },
        "sourceStateSchemaVersion": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "integer", "minimum": 0 },
        "priorVerifiedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "priorRun": { "type": "object" },
        "priorQueue": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "priorActiveMilestoneId": { "type": ["string", "null"] },
        "priorNextAllowedAction": { "type": "string", "minLength": 1 },
        "archivedAt": { "type": "string", "format": "date-time" },
        "reason": { "const": "external-integration-reconciliation" }
      }
    }
  }
}
