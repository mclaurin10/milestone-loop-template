{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestone-loop.local/schemas/orchestrator-config-1.6.0.json",
  "title": "Milestone Loop Orchestrator Configuration",
  "description": "Strict current-version configuration after any supported legacy migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "targetBranch",
    "statePath",
    "artifactRoot",
    "workspaceRoot",
    "workerSandbox",
    "plannerSandbox",
    "reviewerSandbox",
    "approvalPolicy",
    "networkAccessEnabled",
    "candidateExecution",
    "preserveFailedWorkspaces",
    "cleanupCompletedWorkspaces",
    "evidenceRetention",
    "hiddenValidationEnabled",
    "agentPolicy",
    "limits",
    "protectedPaths"
  ],
  "properties": {
    "schemaVersion": { "const": "1.6.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authorityFile", "verticalSpine"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "authorityFile": { "$ref": "#/$defs/safeRelativePath" },
        "verticalSpine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumCategories", "categoryPatterns"],
          "properties": {
            "minimumCategories": { "$ref": "#/$defs/positiveInteger" },
            "categoryPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S",
                "format": "regex"
              }
            }
          }
        }
      }
    },
    "targetBranch": { "$ref": "#/$defs/nonEmptyString" },
    "statePath": { "$ref": "#/$defs/safeRelativePath" },
    "artifactRoot": { "$ref": "#/$defs/safeRelativePath" },
    "workspaceRoot": { "$ref": "#/$defs/safeRelativePath" },
    "workerSandbox": { "const": "workspace-write" },
    "plannerSandbox": { "const": "read-only" },
    "reviewerSandbox": { "const": "read-only" },
    "approvalPolicy": { "const": "on-request" },
    "networkAccessEnabled": { "const": false },
    "candidateExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "trustedContainer"],
      "properties": {
        "mode": {
          "enum": ["trusted-container", "unsafe-local-diagnostic"]
        },
        "trustedContainer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "imageDigest",
            "mountPolicyVersion",
            "resourceLimitProfile",
            "networkDisposition"
          ],
          "properties": {
            "runtime": { "enum": ["docker", "podman"] },
            "imageDigest": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              ]
            },
            "mountPolicyVersion": { "$ref": "#/$defs/nonEmptyString" },
            "resourceLimitProfile": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "networkDisposition": { "const": "denied" }
          }
        }
      }
    },
    "preserveFailedWorkspaces": { "type": "boolean" },
    "cleanupCompletedWorkspaces": { "type": "boolean" },
    "evidenceRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRoot", "keepRecentRuns"],
      "properties": {
        "artifactRoot": { "$ref": "#/$defs/safeRelativePath" },
        "keepRecentRuns": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "hiddenValidationEnabled": { "type": "boolean" },
    "agentPolicy": {
      "$ref": "https://milestone-loop.local/schemas/orchestrator-model-policy-1.0.0.json"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptsPerMilestone",
        "consecutiveInfrastructureFailures",
        "wallClockMs",
        "codexInvocations",
        "tokenBudget",
        "milestonesPerInvocation",
        "codexTurnMs",
        "commandMs",
        "hiddenValidationCooldownMs",
        "plannerProposalAttempts",
        "maximumPermittedPaths",
        "maximumAcceptanceCriteria",
        "maximumEstimatedFiles",
        "commandOutputLimitBytes",
        "commandKillGraceMs"
      ],
      "properties": {
        "attemptsPerMilestone": { "$ref": "#/$defs/positiveInteger" },
        "consecutiveInfrastructureFailures": {
          "$ref": "#/$defs/positiveInteger"
        },
        "wallClockMs": { "$ref": "#/$defs/positiveInteger" },
        "codexInvocations": { "$ref": "#/$defs/positiveInteger" },
        "tokenBudget": { "$ref": "#/$defs/positiveInteger" },
        "milestonesPerInvocation": {
          "$ref": "#/$defs/positiveInteger"
        },
        "codexTurnMs": { "$ref": "#/$defs/positiveInteger" },
        "commandMs": { "$ref": "#/$defs/positiveInteger" },
        "hiddenValidationCooldownMs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "plannerProposalAttempts": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maximumPermittedPaths": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maximumAcceptanceCriteria": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maximumEstimatedFiles": {
          "$ref": "#/$defs/positiveInteger"
        },
        "commandOutputLimitBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "commandKillGraceMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/safeRelativePath" },
          { "not": { "pattern": "[*?]" } }
        ]
      },
      "allOf": [
        { "contains": { "const": "evals/ACCEPTANCE.md" } },
        { "contains": { "const": "evals/acceptance-manifest.json" } },
        {
          "contains": { "const": "evals/HIDDEN_VALIDATION_PROTOCOL.md" }
        },
        {
          "contains": { "const": "evals/immutable-contract-lock.json" }
        },
        { "contains": { "const": "AGENTS.md" } },
        {
          "contains": { "const": ".agent/readiness-profile-activated.json" }
        },
        { "contains": { "const": "scripts/verify.mjs" } },
        { "contains": { "const": "pnpm-lock.yaml" } },
        { "contains": { "const": "package.json" } },
        {
          "contains": {
            "const": "tools/milestone-orchestrator/config/invariant-suite.json"
          }
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "\\S",
      "allOf": [
        { "not": { "pattern": "^[\\\\/]" } },
        { "not": { "pattern": "^[A-Za-z]:[\\\\/]" } },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        },
        { "not": { "pattern": "[\\r\\n\\u0000]" } },
        { "not": { "pattern": "^(?:[\\\\/]*\\.?)*[\\\\/]*$" } }
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
