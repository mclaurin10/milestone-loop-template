{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestone-loop.local/schemas/orchestrator-milestone-1.1.0.json",
  "title": "Example Project Orchestrator Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "kind",
    "objective",
    "rationale",
    "dependencies",
    "permittedPaths",
    "exclusions",
    "acceptanceCriteria",
    "requiredTests",
    "verificationCommands",
    "expectedArtifacts",
    "terminalConditions",
    "estimatedFileCount",
    "requiresBrowserInspection",
    "requiresHeadlessEvaluation",
    "hiddenValidation"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "kind": {
      "enum": [
        "tooling",
        "verification",
        "lifecycle",
        "feature",
        "documentation"
      ]
    },
    "objective": { "type": "string", "minLength": 10 },
    "rationale": { "type": "string", "minLength": 10 },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "permittedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "requiredTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "args", "parser"],
        "properties": {
          "id": { "type": "string" },
          "executable": { "enum": ["pnpm", "node", "git"] },
          "args": { "type": "array", "items": { "type": "string" } },
          "parser": { "enum": ["exit-code", "pnpm-verify"] },
          "timeoutMs": { "type": "integer", "minimum": 1000 }
        }
      }
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "terminalConditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "estimatedFileCount": { "type": "integer", "minimum": 1 },
    "requiresBrowserInspection": { "type": "boolean" },
    "requiresHeadlessEvaluation": { "type": "boolean" },
    "hiddenValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": { "type": "boolean" },
        "checkpointId": { "type": "string" }
      }
    },
    "verticalSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "userGoal",
        "publicActionKinds",
        "sharedRuleOwners",
        "standardCompositionOwner",
        "persistenceReplayEvidence",
        "nodeWorkerParityEvidence",
        "inspectableConsequence",
        "exception"
      ],
      "properties": {
        "mode": { "enum": ["not-applicable", "integrated", "exception"] },
        "userGoal": { "type": ["string", "null"] },
        "publicActionKinds": { "$ref": "#/$defs/stringArray" },
        "sharedRuleOwners": { "$ref": "#/$defs/stringArray" },
        "standardCompositionOwner": { "type": ["string", "null"] },
        "persistenceReplayEvidence": { "$ref": "#/$defs/stringArray" },
        "nodeWorkerParityEvidence": { "$ref": "#/$defs/stringArray" },
        "inspectableConsequence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "readModelPaths",
                "browserEvidenceRequired",
                "description"
              ],
              "properties": {
                "readModelPaths": { "$ref": "#/$defs/stringArray" },
                "browserEvidenceRequired": { "type": "boolean" },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "exception": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "justification",
                "immediateConsumerMilestoneId",
                "consumerContract"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "kernel-only",
                    "fixture-only",
                    "migration-only",
                    "preview-only"
                  ]
                },
                "justification": { "type": "string", "minLength": 1 },
                "immediateConsumerMilestoneId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                },
                "consumerContract": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.1.0" } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["verticalSlice"] },
      "else": { "not": { "required": ["verticalSlice"] } }
    }
  ]
}
