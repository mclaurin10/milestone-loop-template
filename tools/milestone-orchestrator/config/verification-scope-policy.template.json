      "<CHECK_IDS_TO_RUN_WHEN_THAT_PACKAGE_CHANGES>"
    ]
  },
  "graduation": {
    "deferred": true,
    "minimumComparisons": 30,
    "minimumExamplesPerTrigger": 3,
    "requiresZeroFalseNegatives": true,
    "requiresZeroUnknowns": true,
    "requiresDeterministicRecommendations": true,
