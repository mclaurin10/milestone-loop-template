{
  "schemaVersion": "1.0.0",
  "id": "milestone-loop-core-invariants.v1",
  "warmRuntimeTargetMs": 60000,
  "serial": true,
  "entries": [
    {
      "id": "protected-integrity",
      "ownerPaths": [
        "PROJECT_GOAL.md",
        "evals/",
        "scripts/verify.mjs",
        "tools/milestone-orchestrator/src/contract-integrity.ts"
      ],
      "triggerPaths": [
        "PROJECT_GOAL.md",
        "AGENTS.md",
        "evals/",
        ".agent/",
        "scripts/verify.mjs",
        "tools/milestone-orchestrator/src/contract-integrity.ts"
      ],
      "argv": [
        "node",
        "node_modules/tsx/dist/cli.mjs",
        "tools/milestone-orchestrator/src/verification-cli.ts",
        "contract-integrity"
      ],
      "expectedArtifactKinds": ["contract-integrity-report"]
    },
    {
      "id": "test-ownership",
      "ownerPaths": [
        "package.json",
        "vitest.config.ts",
        ".github/workflows/exact-runtime-ci.yml",
        ".agent/verification-manifest.json",
        "fixtures/oci-candidate/package.json",
        "fixtures/oci-candidate/vitest.config.ts",
        "tools/milestone-orchestrator/config/test-ownership.json",
        "tools/milestone-orchestrator/src/test-ownership.ts",
        "tools/milestone-orchestrator/src/test-ownership-cli.ts",
        "tools/milestone-orchestrator/template/bootstrap-adopter/scaffold/vitest.config.ts"
      ],
      "triggerPaths": [
        ".agent/verification-manifest.json",
        ".github/workflows/exact-runtime-ci.yml",
        "fixtures/oci-candidate/",
        "package.json",
        "tools/",
        "vitest.config.ts"
      ],
      "argv": [
        "node",
        "node_modules/tsx/dist/cli.mjs",
        "tools/milestone-orchestrator/src/test-ownership-cli.ts"
      ],
      "expectedArtifactKinds": ["test-ownership-report"]
    },
    {
      "id": "orchestrator-schema-integrity",
      "ownerPaths": ["tools/milestone-orchestrator/src/schema.ts"],
      "triggerPaths": ["tools/milestone-orchestrator/"],
      "argv": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "tools/milestone-orchestrator/src/schema.test.ts",
        "--fileParallelism=false"
      ],
      "expectedArtifactKinds": ["invariant-vitest-report"]
    },
    {
      "id": "orchestrator-policy-integrity",
      "ownerPaths": ["tools/milestone-orchestrator/src/policy.ts"],
      "triggerPaths": ["tools/milestone-orchestrator/"],
      "argv": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "tools/milestone-orchestrator/src/policy.test.ts",
        "--fileParallelism=false"
      ],
      "expectedArtifactKinds": ["invariant-vitest-report"]
    },
    {
      "id": "fail-closed-evidence",
      "ownerPaths": [
        "tools/milestone-orchestrator/src/verifier.ts",
        "tools/evidence.mjs"
      ],
      "triggerPaths": ["tools/"],
      "argv": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "tools/milestone-orchestrator/src/verifier.test.ts",
        "--fileParallelism=false"
      ],
      "expectedArtifactKinds": ["invariant-vitest-report"]
    }
  ]
}
