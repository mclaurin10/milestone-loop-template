{
  "schemaVersion": "1.0.0",
  "id": "<YOUR_INVARIANT_SUITE_ID>.v1",
  "warmRuntimeTargetMs": 60000,
  "serial": true,
  "entries": [
    {
      "id": "protected-integrity",
      "ownerPaths": [
        "<YOUR_AUTHORITY_FILE>.md",
        "evals/",
        "scripts/verify.mjs",
        "tools/milestone-orchestrator/src/contract-integrity.ts"
      ],
      "triggerPaths": [
        "<YOUR_AUTHORITY_FILE>.md",
        "AGENTS.md",
        "evals/",
        ".agent/",
        "scripts/verify.mjs",
        "tools/milestone-orchestrator/src/contract-integrity.ts"
      ],
      "argv": [
        "node",
        "node_modules/tsx/dist/cli.mjs",
        "tools/milestone-orchestrator/src/verification-cli.ts",
        "contract-integrity"
      ],
      "expectedArtifactKinds": ["contract-integrity-report"]
    },
    {
      "id": "<YOUR_CORE_INVARIANT_ID>",
      "ownerPaths": ["<PATH_TO_THE_FILE_THAT_OWNS_THE_INVARIANT>"],
      "triggerPaths": ["<PATH_PREFIX_THAT_SHOULD_TRIGGER_THIS_INVARIANT>/"],
      "testFile": "<OPTIONAL_EXACT_TEST_FILE>.test.ts",
      "testTitle": "<OPTIONAL_EXACT_TEST_TITLE_STRING_PINNED_INSIDE_THAT_FILE>",
      "argv": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "<OPTIONAL_EXACT_TEST_FILE>.test.ts",
        "--fileParallelism=false"
      ],
      "expectedArtifactKinds": ["invariant-vitest-report"]
    }
  ]
}
