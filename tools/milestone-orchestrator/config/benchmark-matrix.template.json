{
  "schemaVersion": "1.0.0",
  "id": "<YOUR_HISTORICAL_BENCHMARK_MATRIX_ID>.v1",
  "serial": true,
  "warmup": 1,
  "repeat": 3,
  "thresholds": {
    "minimumImprovementMs": 10000,
    "noiseMultiplier": 2,
    "maximumClosureRegressionMs": 15000
  },
  "unknownProbePaths": ["benchmark-inputs/unowned-change.probe"],
  "historical": {
    "fullSafeCheckIds": [
      "<EVERY_CHECK_ID_THE_LOOP_RAN_BEFORE_SCOPE_SELECTION_EXISTED>"
    ],
    "iterationCheckIdsByClass": {
      "leaf-ui-only": ["<HISTORICAL_ITERATION_CHECK_IDS_FOR_LEAF_UI_CHANGES>"],
      "domain-local-simulation": [
        "<HISTORICAL_ITERATION_CHECK_IDS_FOR_DOMAIN_LOCAL_CHANGES>"
      ]
    }
  },
  "classes": [
    {
      "id": "leaf-ui-only",
      "measurement": "command-workflows",
      "comparisons": ["iteration", "candidate"],
      "paths": ["<A_LEAF_UI_FILE_IN_YOUR_REPO>"],
      "mustExclude": ["<PATH_PREFIXES_A_LEAF_UI_SELECTION_MUST_NOT_TOUCH>/"]
    },
    {
      "id": "domain-local-simulation",
      "measurement": "command-workflows",
      "comparisons": ["iteration"],
      "paths": ["<A_DOMAIN_LOCAL_FILE_IN_YOUR_REPO>"],
      "mustExclude": [
        "<PATH_PREFIXES_A_DOMAIN_LOCAL_SELECTION_MUST_NOT_TOUCH>/"
      ]
    },
    {
      "id": "shared-protocol-persistence",
      "measurement": "selection-expansion",
      "comparisons": ["scope-expansion"],
      "paths": ["<SHARED_PROTOCOL_AND_PERSISTENCE_FILES_IN_YOUR_REPO>"],
      "mustExclude": []
    },
    {
      "id": "worker-public-message",
      "measurement": "selection-expansion",
      "comparisons": ["scope-expansion"],
      "paths": ["<WORKER_BOUNDARY_FILES_IN_YOUR_REPO>"],
      "mustExclude": []
    },
    {
      "id": "milestone-closure",
      "measurement": "exact-closure",
      "comparisons": ["closure"],
      "paths": [".agent/completed/loop-recommissioning-verification.json"],
      "mustExclude": []
    }
  ]
}
